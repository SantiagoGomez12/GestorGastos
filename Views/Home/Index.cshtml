@model List<GestorGastos.Models.Gasto>

        <style>
            .contenedor {
                width: 650px;
                margin: 30px auto;
                padding: 20px;
            }

            .campo {
                width: 100%;
                padding: 10px;
                margin-bottom: 12px;
                box-sizing: border-box;
            }

            .boton {
                padding: 9px 15px;
                cursor: pointer;
            }

            .gasto {
                border: 1px solid gray;
                padding: 12px;
                margin-top: 12px;
            }

            .resumen {
                border: 1px solid gray;
                padding: 15px;
                margin-bottom: 20px;
            }

            .error {
                color: red;
            }
</style>

<div class="contenedor">

            <h1>Mi Gestor de Gastos</h1>

            <div class="resumen">

                <h3>Resumen del mes</h3>

                <p>Total gastado este mes:</p>

                <h2>$@ViewBag.TotalMes.ToString("N0")</h2>

    </div>

    <h3>Registrar un gasto</h3>

    <form asp-controller="Gastos"
          asp-action="Agregar"
          method="post"
          novalidate>

                <p>Descripcion:</p>

                <input type="text"
                       name="descripcion"
                       class="campo"
                       placeholder="Ejemplo: Compra de alimentos" />

                <p>Valor del gasto:</p>

                <input type="number"
                       name="valor"
                       class="campo"
                       step="0.01" />

                <p>Categoria:</p>

                    <select name="categoria" class="campo">

                        <option value="Alimentacion">Alimentacion</option>

                        <option value="Transporte">Transporte</option>

                        <option value="Estudio">Estudio</option>

                        <option value="Servicios">Servicios</option>

                        <option value="Otros">Otros</option>

                    </select>

                    <button type="submit" class="boton">
                        Registrar gasto
                    </button>
    
    </form>

    @if (ViewBag.Error != null)
            {
                <p class="error">@ViewBag.Error</p>
            }

            <hr />

            <h3>Mis gastos</h3>

    @if (Model.Count == 0)
    {
        <p>No hay gastos registrados.</p>
    }

    @foreach (var gasto in Model)
    {
        <div class="gasto">

            <h3>@gasto.Descripcion</h3>

            <p>Costo: $@gasto.Costo.ToString("N0")</p>

            <p>Categoria: @gasto.Categoria</p>

            <p>Fecha: @gasto.Fecha.ToString("dd/mm/yyyy")</p>

                    <form asp-controller="Gastos"
                          asp-action="Eliminar"
                          method="post">

                        <input type="hidden"
                               name="id"
                               value="@gasto.Id" />

                        <button type="submit" class="boton">
                            Eliminar
                        </button>

                    </form>

        </div>
    }

</div>
